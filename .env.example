# Копия для разработчика: cp .env.example .env
# Реальные значения НИКОГДА не коммитятся (инвариант 7).
# На Render значения задаются в панели сервиса, не в этом файле.

# --- База данных ---
# Две роли, а не одна (server/sql/app-role.sql):
#
#   DATABASE_URL         — рантайм. Роль bruteforce_app: SELECT/INSERT/
#                          UPDATE/DELETE по строкам и ничего больше.
#   MIGRATE_DATABASE_URL — миграции. Роль-владелец с правами DDL.
#                          Используется только командой db:migrate.
#
# Если MIGRATE_DATABASE_URL не задан, миграции идут по DATABASE_URL —
# так работают локальная разработка и CI, где база одноразовая.
#
# Neon: ОБЯЗАТЕЛЬНО pooled-строка (в хосте есть "-pooler"), не прямая.
# См. docs/adr/0001-stack.md.
DATABASE_URL=postgres://bruteforce_app:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
MIGRATE_DATABASE_URL=postgres://neondb_owner:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Авторизация (Better Auth) ---
# Секрет подписи сессий. Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Публичный URL сервера, на который клиент шлёт запросы авторизации.
BETTER_AUTH_URL=http://localhost:8787

# --- Сервер ---
PORT=8787
NODE_ENV=development
# Через запятую. Origin клиента, которому разрешён доступ с куками.
CORS_ORIGINS=http://localhost:5173
# debug | info | warn | error
LOG_LEVEL=info

# --- Клиент (apps/web) ---
# Всё под префиксом VITE_ ПОПАДАЕТ В БРАУЗЕРНЫЙ БАНДЛ. Секретов здесь быть не может.
VITE_API_URL=http://localhost:8787
