{
  "name": "@extramundum/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "dev": "node --watch --env-file-if-exists=../.env src/main.ts",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../.env src/db/migrate.ts",
    "db:migrate:dist": "node dist/db/migrate.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@extramundum/data": "workspace:*",
    "@extramundum/shared": "workspace:*",
    "@extramundum/sim": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "better-auth": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.7",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.2",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6"
  }
}
